# Roxy Environment Configuration
# Copy this file to .env and fill in your values

# ═══════════════════════════════════════════════════════════════
# WALLET ADDRESSES (Public - Safe to share)
# ═══════════════════════════════════════════════════════════════

# Your main EVM wallet address
ROXY_EVM_WALLET=YOUR_WALLET_ADDRESS

# Your Solana wallet address  
ROXY_SOLANA_WALLET=YOUR_SOLANA_ADDRESS

# Rescue wallet addresses (for auto-sweep protection)
RESCUE_EVM_WALLET=YOUR_RESCUE_WALLET_ADDRESS
RESCUE_SOLANA_WALLET=YOUR_RESCUE_SOLANA_ADDRESS

# ═══════════════════════════════════════════════════════════════
# RPC ENDPOINTS (Get free keys from providers)
# ═══════════════════════════════════════════════════════════════

# Ethereum
ETHEREUM_RPC=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Layer 2s
BASE_RPC=https://base-mainnet.g.alchemy.com/v2/YOUR_API_KEY
ARBITRUM_RPC=https://arb-mainnet.g.alchemy.com/v2/YOUR_API_KEY
OPTIMISM_RPC=https://opt-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Other EVM chains
POLYGON_RPC=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY
ZKSYNC_RPC=https://zksync-mainnet.g.alchemy.com/v2/YOUR_API_KEY
LINEA_RPC=https://linea-mainnet.g.alchemy.com/v2/YOUR_API_KEY
SCROLL_RPC=https://scroll-mainnet.g.alchemy.com/v2/YOUR_API_KEY
BLAST_RPC=https://blast-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Solana
SOLANA_RPC=https://api.mainnet-beta.solana.com

# ═══════════════════════════════════════════════════════════════
# NOTIFICATIONS
# ═══════════════════════════════════════════════════════════════

# Telegram Bot (for notifications)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# ═══════════════════════════════════════════════════════════════
# SECURITY
# ═══════════════════════════════════════════════════════════════

# Encryption password for wallet files
ENCRYPTION_PASSWORD=YOUR_ENCRYPTION_PASSWORD

# Li.Fi API (for bridge aggregation)
LIFI_API_KEY=YOUR_LIFI_API_KEY
